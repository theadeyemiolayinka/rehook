# Server
REHOOK_LISTEN_ADDR=0.0.0.0:8080
REHOOK_DATABASE_URL=sqlite:data/rehook.db
REHOOK_DATA_DIR=./data

# Bootstrap administrator (read only on first startup, never overwrites existing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Trusted reverse proxy. Set to the number of trusted proxy hops, or 0 to
# trust only the direct socket peer. See ARCHITECTURE.md.
REHOOK_TRUSTED_PROXY_HOPS=0

# Public base URL used to construct inbound webhook URLs shown in the dashboard.
REHOOK_PUBLIC_BASE_URL=http://localhost:8080

# Limits
REHOOK_MAX_WEBHOOK_BODY_SIZE=1048576
REHOOK_MAX_STORED_EVENTS=10000
REHOOK_EVENT_RETENTION_DAYS=14

# Session
REHOOK_SESSION_KEY=please-change-this-to-a-32-byte-hex-secret
REHOOK_SESSION_TTL_HOURS=720

# Logging
RUST_LOG=rehook=info,tower_http=info

# Dashboard assets directory (built admin dashboard served by the server in prod).
# Security: this directory is served to any HTTP client. Do not point it at
# the filesystem root, the data directory, or any path containing '..'.
# The server validates this at startup and refuses to start if misconfigured.
REHOOK_DASHBOARD_DIR=./dashboards/admin/dist
