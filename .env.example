# Server
HOOKRELAY_LISTEN_ADDR=0.0.0.0:8080
HOOKRELAY_DATABASE_URL=sqlite:data/hookrelay.db
HOOKRELAY_DATA_DIR=./data

# Bootstrap administrator (read only on first startup, never overwrites existing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Trusted reverse proxy. Set to the number of trusted proxy hops, or 0 to
# trust only the direct socket peer. See ARCHITECTURE.md.
HOOKRELAY_TRUSTED_PROXY_HOPS=0

# Public base URL used to construct inbound webhook URLs shown in the dashboard.
HOOKRELAY_PUBLIC_BASE_URL=http://localhost:8080

# Limits
HOOKRELAY_MAX_WEBHOOK_BODY_SIZE=1048576
HOOKRELAY_MAX_STORED_EVENTS=10000
HOOKRELAY_EVENT_RETENTION_DAYS=14

# Session
HOOKRELAY_SESSION_KEY=please-change-this-to-a-32-byte-hex-secret
HOOKRELAY_SESSION_TTL_HOURS=720

# Logging
RUST_LOG=hookrelay=info,tower_http=info

# Dashboard assets directory (built admin dashboard served by the server in prod).
HOOKRELAY_DASHBOARD_DIR=./dashboards/admin/dist
